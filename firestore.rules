rules_version = '2';

// ===============================================================
// Assumed Data Model — อสม.สามารถ (Orsomo Smart)
// ===============================================================
//
// Authentication Architecture:
//   - Frontend authenticates users via LINE LIFF (producing a LINE userId)
//     paired with Firebase Anonymous Authentication (request.auth.uid), or direct Firebase Auth.
//   - Supports Direct Account lookup (/VHVs/{request.auth.uid}) and
//     Two-Tier Session Binding (/Auth_Sessions/{request.auth.uid} -> liff_uid -> /VHVs/{liff_uid}).
//   - /VHVs/{liffUid} stores user profile, role ('ADMIN', 'SUB_ADMIN',
//     'VHV', 'None' — case and whitespace tolerant), and approval status
//     ('Active', 'Pending', 'Rejected' — case and whitespace tolerant).
//
// Collection: Auth_Sessions
// Document ID: {authUid} (must equal request.auth.uid)
// Fields:
//   - liff_uid: string (required, 1..128 chars) - Bound LINE userId
//   - updated_at: timestamp (optional/merge-friendly) - Last session refresh timestamp
//   - created_at: timestamp (optional, immutable once set)
//   - auth_uid: string (optional, must equal request.auth.uid)
//
// Collection: VHVs
// Document ID: {liffUid} (LINE userId or direct Firebase Auth UID)
// Fields:
//   - uid: string (required on create, immutable, 1..128 chars)
//   - name: string (required, 1..200 chars)
//   - nickname: string (optional, <= 100 chars)
//   - phone: string (optional, <= 50 chars)
//   - role: string (required, enum: ['ADMIN', 'SUB_ADMIN', 'VHV', 'None'] - case tolerant)
//   - status: string (required, enum: ['Active', 'Pending', 'Rejected'] - case tolerant)
//   - village_no: string | number (optional, <= 30 chars or 0..9999)
//   - hospital_name: string (optional, <= 300 chars)
//   - assigned_villages: list (optional, <= 100 items)
//   - profile_pic / photoURL / pic_url: string (optional, <= 500000 chars)
//   - secret_verify: string (optional, <= 256 chars, registration verification)
//   - timestamp / updated_at / created_at: timestamp | string | number (optional)
//
// Collection: SystemConfig
// Document ID: {configId} (e.g., HOSPITAL_NAME, VILLAGE_COUNT, DIAPER_PRICE, etc.)
// Fields:
//   - value: string | number | bool | list | map (required, bounded)
//   - updated_at: timestamp | string (optional)
//   - updated_by / description / label: string (optional)
//
// Collection: Configs
// Document ID: {docId} (e.g., FinanceDraft, DiaperProjectSummary)
// Fields:
//   - Admin-only financial/project configuration maps & summaries (bounded)
//
// Collection: Patients
// Document ID: {patientId} (13-digit Thai ID or auto-generated ID)
// Fields:
//   - id, id_card, prefix, name, dob, age, house_no, village_no, lat_long,
//     caregiver_name, caregiver_phone, status, group, adl, dep_status,
//     last_assess, disease, medication (string, list, map, or number), diaper (JSON string or map),
//     equipment, assigned_vhv_id, needs_assessment (bool, string, or number), task_desc,
//     tasks_required (list or string), task_date, profile_pic, pic_bed, pic_bath,
//     pic_entrance, pic_walkway, created_by, creator_uid (immutable for VHV),
//     created_at (immutable for VHV), updated_at, timestamp, plus legacy migrated fields (up to 200 keys).
//
// Collection: Patient_Images
// Document ID: {imageId}
// Fields:
//   - patient_id, type, profile_pic, pic_bed, pic_bath, pic_entrance,
//     pic_walkway, image_data / url / base64, updated_by, updated_at
//
// Collection: Assessments | Vitals | Home_Visits
// Document ID: {assessId} | {vitalId} | {visitId}
// Fields:
//   - patient_id (required), date, type/scores/vitals/visit notes,
//     assessor_uid, assessor_name, timestamp
//
// Collection: Inventory_Items | Inventory_Transactions
// Document ID: {itemId} | {txId}
// Fields:
//   - Inventory_Items: id, name (required), unit, category, balance (required), created_at
//   - Inventory_Transactions: type (required), round, items (required list), note,
//     actor_uid, actor_name, timestamp
//
// Collection: Equipment_Items | Equipment_Loans
// Document ID: {itemId} | {loanId}
// Fields:
//   - Equipment_Items: Staff-only medical equipment registry (read/write by Staff)
//   - Equipment_Loans: Readable by approved users (for patient status loan alerts),
//     created/updated/deleted strictly by Staff (ADMIN, SUB_ADMIN)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Common Validation & Identity Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function uidNotModified() {
      return !('uid' in resource.data) ||
        (('uid' in request.resource.data) && request.resource.data.uid == resource.data.uid);
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalStringOrNumber(data, field, maxStrLen, minNum, maxNum) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= maxStrLen) ||
        (data[field] is number && data[field] >= minNum && data[field] <= maxNum);
    }

    function isOptionalTimestampOrString(data, field, maxStrLen) {
      return !(field in data) || data[field] == null ||
        (data[field] is timestamp) ||
        (data[field] is string && data[field].size() <= maxStrLen) ||
        (data[field] is number && data[field] >= 0 && data[field] <= 999999999999999);
    }

    function isOptionalTimestampStringOrNumber(data, field, maxStrLen, minNum, maxNum) {
      return !(field in data) || data[field] == null ||
        (data[field] is timestamp) ||
        (data[field] is string && data[field].size() <= maxStrLen) ||
        (data[field] is number && data[field] >= minNum && data[field] <= maxNum);
    }

    function isOptionalBoundedList(data, field, maxItems) {
      return !(field in data) || data[field] == null ||
        (data[field] is list && data[field].size() <= maxItems);
    }

    // ===============================================================
    // Session & RBAC Lookup Helpers (/Auth_Sessions -> /VHVs)
    // ===============================================================

    function hasSession() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/Auth_Sessions/$(request.auth.uid));
    }

    function getSessionData() {
      return get(/databases/$(database)/documents/Auth_Sessions/$(request.auth.uid)).data;
    }

    function hasValidSessionLiffUid() {
      return hasSession() &&
        ('liff_uid' in getSessionData()) &&
        (getSessionData().liff_uid is string) &&
        getSessionData().liff_uid.size() >= 1 &&
        getSessionData().liff_uid.size() <= 128;
    }

    function currentLiffUid() {
      return hasValidSessionLiffUid() ? getSessionData().liff_uid : '';
    }

    function isSessionOwner(liffUid) {
      return (isAuthenticated() && request.auth.uid == liffUid) ||
        (hasValidSessionLiffUid() && currentLiffUid() == liffUid);
    }

    function hasVhvDirectAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/VHVs/$(request.auth.uid));
    }

    function hasVhvAccount() {
      return hasVhvDirectAccount() || (
        hasValidSessionLiffUid() &&
        exists(/databases/$(database)/documents/VHVs/$(currentLiffUid()))
      );
    }

    function currentVhvData() {
      return hasVhvDirectAccount()
        ? get(/databases/$(database)/documents/VHVs/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/VHVs/$(currentLiffUid())).data;
    }

    function isActiveVhvStatus(vhv) {
      return ('status' in vhv) &&
        (vhv.status is string) &&
        (
          (vhv.status in ['Active', 'active', 'ACTIVE']) ||
          vhv.status.matches('(?i)^\\s*active\\s*$')
        );
    }

    function hasVhvRole(vhv, allowedRoles) {
      return ('role' in vhv) &&
        (vhv.role is string) &&
        (
          (vhv.role in allowedRoles) ||
          (
            ('ADMIN' in allowedRoles || 'admin' in allowedRoles || 'Admin' in allowedRoles) &&
            vhv.role.matches('(?i)^\\s*admin\\s*$')
          ) ||
          (
            ('SUB_ADMIN' in allowedRoles || 'sub_admin' in allowedRoles || 'Sub_Admin' in allowedRoles) &&
            vhv.role.matches('(?i)^\\s*sub_admin\\s*$')
          ) ||
          (
            ('VHV' in allowedRoles || 'vhv' in allowedRoles || 'Vhv' in allowedRoles) &&
            vhv.role.matches('(?i)^\\s*vhv\\s*$')
          )
        );
    }

    function isApprovedUser() {
      return hasVhvAccount() &&
        isActiveVhvStatus(currentVhvData()) &&
        hasVhvRole(currentVhvData(), [
          'ADMIN', 'admin', 'Admin',
          'SUB_ADMIN', 'sub_admin', 'Sub_Admin',
          'VHV', 'vhv', 'Vhv'
        ]);
    }

    function isAdmin() {
      return hasVhvAccount() &&
        isActiveVhvStatus(currentVhvData()) &&
        hasVhvRole(currentVhvData(), ['ADMIN', 'admin', 'Admin']);
    }

    function isSubAdmin() {
      return hasVhvAccount() &&
        isActiveVhvStatus(currentVhvData()) &&
        hasVhvRole(currentVhvData(), ['SUB_ADMIN', 'sub_admin', 'Sub_Admin']);
    }

    function isStaff() {
      return isAdmin() || isSubAdmin();
    }

    function isActiveVHV() {
      return hasVhvAccount() &&
        isActiveVhvStatus(currentVhvData()) &&
        hasVhvRole(currentVhvData(), ['VHV', 'vhv', 'Vhv']);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidAuthSession(data) {
      return data is map &&
        ('liff_uid' in data) &&
        (data.liff_uid is string) &&
        data.liff_uid.size() >= 1 &&
        data.liff_uid.size() <= 128;
    }

    function isValidVhv(data) {
      return data is map &&
        data.keys().size() >= 3 &&
        data.keys().size() <= 25 &&
        ('name' in data) && (data.name is string) && data.name.size() >= 1 && data.name.size() <= 200 &&
        ('role' in data) && (data.role is string) &&
        (
          (data.role in [
            'ADMIN', 'admin', 'Admin',
            'SUB_ADMIN', 'sub_admin', 'Sub_Admin',
            'VHV', 'vhv', 'Vhv',
            'None', 'none', 'NONE'
          ]) ||
          data.role.matches('(?i)^\\s*(admin|sub_admin|vhv|none)\\s*$')
        ) &&
        ('status' in data) && (data.status is string) &&
        (
          (data.status in [
            'Active', 'active', 'ACTIVE',
            'Pending', 'pending', 'PENDING',
            'Rejected', 'rejected', 'REJECTED'
          ]) ||
          data.status.matches('(?i)^\\s*(active|pending|rejected)\\s*$')
        ) &&
        isOptionalString(data, 'uid', 128) &&
        isOptionalString(data, 'nickname', 100) &&
        isOptionalString(data, 'phone', 50) &&
        isOptionalStringOrNumber(data, 'village_no', 30, 0, 9999) &&
        isOptionalStringOrNumber(data, 'village', 30, 0, 9999) &&
        isOptionalString(data, 'hospital_name', 300) &&
        isOptionalBoundedList(data, 'assigned_villages', 100) &&
        isOptionalString(data, 'profile_pic', 500000) &&
        isOptionalString(data, 'photoURL', 500000) &&
        isOptionalString(data, 'pic_url', 500000) &&
        isOptionalString(data, 'secret_verify', 256) &&
        isOptionalString(data, 'fcm_token', 1024) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isMatchingSecretValue(secretStr, configVal) {
      return (configVal is string && configVal.size() >= 1 && secretStr == configVal) ||
        (configVal is int && secretStr == string(configVal)) ||
        (configVal is float && secretStr == string(configVal));
    }

    function isValidAdminSecretVerify(data) {
      return ('secret_verify' in data) &&
        (data.secret_verify is string) &&
        data.secret_verify.size() >= 1 &&
        data.secret_verify.size() <= 256 &&
        exists(/databases/$(database)/documents/SystemConfig/ADMIN_SECRET_CODE) &&
        ('value' in get(/databases/$(database)/documents/SystemConfig/ADMIN_SECRET_CODE).data) &&
        isMatchingSecretValue(
          data.secret_verify,
          get(/databases/$(database)/documents/SystemConfig/ADMIN_SECRET_CODE).data.value
        );
    }

    function isValidSubAdminSecretVerify(data) {
      return ('secret_verify' in data) &&
        (data.secret_verify is string) &&
        data.secret_verify.size() >= 4 &&
        data.secret_verify.size() <= 256;
    }

    function isValidSystemConfig(data) {
      return data is map &&
        hasRequiredFields(['value']) &&
        hasOnlyAllowedFields(['value', 'updated_at', 'updated_by', 'description', 'label']) &&
        (
          (data.value is string && data.value.size() <= 100000) ||
          (data.value is number && data.value >= 0 && data.value <= 1000000000) ||
          (data.value is bool) ||
          (data.value is list && data.value.size() <= 200) ||
          (data.value is map && data.value.keys().size() <= 100)
        ) &&
        isOptionalTimestampOrString(data, 'updated_at', 100) &&
        isOptionalString(data, 'updated_by', 128) &&
        isOptionalString(data, 'description', 500) &&
        isOptionalString(data, 'label', 200);
    }

    function isValidConfigDoc(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 100 &&
        isOptionalTimestampOrString(data, 'updatedAt', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100) &&
        isOptionalBoundedList(data, 'projects', 500) &&
        (!('incomes' in data) || data.incomes == null || (data.incomes is map && data.incomes.keys().size() <= 50)) &&
        (!('section2Overrides' in data) || data.section2Overrides == null || (data.section2Overrides is map && data.section2Overrides.keys().size() <= 100)) &&
        (!('section2Targets' in data) || data.section2Targets == null || (data.section2Targets is map && data.section2Targets.keys().size() <= 100)) &&
        isOptionalStringOrNumber(data, 'mgtFeePct', 30, 0, 100);
    }

    // Flexible patient validator preserving compatibility with legacy migrated fields
    // while enforcing strict type/size bounds on all known fields against 1MB DoS attacks.
    function isValidPatient(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 200 &&
        isOptionalStringOrNumber(data, 'id', 128, 0, 999999999999999) &&
        isOptionalStringOrNumber(data, 'id_card', 30, 0, 999999999999999) &&
        isOptionalString(data, 'prefix', 50) &&
        isOptionalString(data, 'name', 300) &&
        isOptionalTimestampStringOrNumber(data, 'dob', 100, 0, 999999999999999) &&
        isOptionalStringOrNumber(data, 'age', 20, 0, 200) &&
        isOptionalStringOrNumber(data, 'house_no', 100, 0, 999999999) &&
        isOptionalStringOrNumber(data, 'village_no', 30, 0, 9999) &&
        (
          !('lat_long' in data) || data.lat_long == null ||
          (data.lat_long is string && data.lat_long.size() <= 200) ||
          (data.lat_long is map && data.lat_long.keys().size() <= 20) ||
          (data.lat_long is latlng)
        ) &&
        isOptionalString(data, 'caregiver_name', 300) &&
        isOptionalStringOrNumber(data, 'caregiver_phone', 100, 0, 999999999999999) &&
        isOptionalStringOrNumber(data, 'status', 100, 0, 100) &&
        isOptionalStringOrNumber(data, 'group', 100, 0, 100) &&
        (
          !('adl' in data) || data.adl == null ||
          (data.adl is string && data.adl.size() <= 100) ||
          (data.adl is number && data.adl >= -1 && data.adl <= 1000) ||
          (data.adl is map && data.adl.keys().size() <= 50)
        ) &&
        isOptionalString(data, 'dep_status', 200) &&
        isOptionalTimestampStringOrNumber(data, 'last_assess', 100, 0, 999999999999999) &&
        (
          !('disease' in data) || data.disease == null ||
          (data.disease is string && data.disease.size() <= 500000) ||
          (data.disease is list && data.disease.size() <= 100) ||
          (data.disease is map && data.disease.keys().size() <= 100) ||
          (data.disease is number && data.disease >= 0 && data.disease <= 999999999)
        ) &&
        (
          !('medication' in data) || data.medication == null ||
          (data.medication is string && data.medication.size() <= 500000) ||
          (data.medication is list && data.medication.size() <= 100) ||
          (data.medication is map && data.medication.keys().size() <= 100) ||
          (data.medication is number && data.medication >= 0 && data.medication <= 999999999)
        ) &&
        (
          !('diaper' in data) || data.diaper == null ||
          (data.diaper is string && data.diaper.size() <= 600000) ||
          (data.diaper is map && data.diaper.keys().size() <= 100)
        ) &&
        (
          !('equipment' in data) || data.equipment == null ||
          (data.equipment is string && data.equipment.size() <= 500000) ||
          (data.equipment is list && data.equipment.size() <= 100) ||
          (data.equipment is map && data.equipment.keys().size() <= 100) ||
          (data.equipment is number && data.equipment >= 0 && data.equipment <= 999999999)
        ) &&
        isOptionalStringOrNumber(data, 'assigned_vhv_id', 128, 0, 999999999999999) &&
        (
          !('needs_assessment' in data) || data.needs_assessment == null ||
          (data.needs_assessment is bool) ||
          (data.needs_assessment is string && data.needs_assessment.size() <= 20) ||
          (data.needs_assessment is number && data.needs_assessment >= -100 && data.needs_assessment <= 100000)
        ) &&
        isOptionalString(data, 'task_desc', 1000) &&
        (
          !('tasks_required' in data) || data.tasks_required == null ||
          (data.tasks_required is list && data.tasks_required.size() <= 50) ||
          (data.tasks_required is string && data.tasks_required.size() <= 1000)
        ) &&
        isOptionalTimestampStringOrNumber(data, 'task_date', 50, 0, 999999999999999) &&
        isOptionalString(data, 'profile_pic', 600000) &&
        isOptionalString(data, 'pic_bed', 600000) &&
        isOptionalString(data, 'pic_bath', 600000) &&
        isOptionalString(data, 'pic_entrance', 600000) &&
        isOptionalString(data, 'pic_walkway', 600000) &&
        isOptionalString(data, 'created_by', 200) &&
        isOptionalString(data, 'creator_uid', 128) &&
        isOptionalTimestampStringOrNumber(data, 'timestamp', 100, 0, 999999999999999) &&
        isOptionalTimestampStringOrNumber(data, 'created_at', 100, 0, 999999999999999) &&
        isOptionalTimestampStringOrNumber(data, 'updated_at', 100, 0, 999999999999999) &&
        isOptionalTimestampStringOrNumber(data, 'last_adl_date', 100, 0, 999999999999999) &&
        isOptionalTimestampStringOrNumber(data, 'last_dep_date', 100, 0, 999999999999999) &&
        isOptionalTimestampStringOrNumber(data, 'last_vital_date', 100, 0, 999999999999999) &&
        isOptionalTimestampStringOrNumber(data, 'last_visit_date', 100, 0, 999999999999999) &&
        isOptionalString(data, 'remark', 5000) &&
        isOptionalString(data, 'notes', 5000) &&
        isOptionalString(data, 'note', 5000);
    }

    function isDiaperMapApproved(dMap) {
      return ('approve_status' in dMap) &&
        (dMap.approve_status is string) &&
        (dMap.approve_status in ['อนุมัติแล้ว', 'approved', 'Approved']);
    }

    function isDiaperStringApproved(dStr) {
      return dStr.matches('(?s).*อนุมัติแล้ว.*') ||
        dStr.matches('(?s).*approved.*') ||
        dStr.matches('(?s).*Approved.*');
    }

    function isExistingDiaperApproved() {
      return resource != null &&
        resource.data.get('diaper', null) != null &&
        (
          (resource.data.get('diaper', null) is map && isDiaperMapApproved(resource.data.diaper)) ||
          (resource.data.get('diaper', null) is string && isDiaperStringApproved(resource.data.diaper))
        );
    }

    // Safeguard for VHV writes on /Patients/{patientId}:
    // - Allows VHVs to update patient profile, assessments, vitals, images, and status cleanly
    //   even when resource != null and resource.data.get('diaper', null) != null.
    // - Prevents a VHV from self-approving a previously unapproved diaper request, while
    //   preserving existing approved status across both legacy JSON strings and normalized maps.
    function canVhvWritePatient() {
      return (
        resource == null &&
        (
          !('diaper' in request.resource.data) ||
          request.resource.data.diaper == null ||
          (request.resource.data.diaper is string && !isDiaperStringApproved(request.resource.data.diaper)) ||
          (request.resource.data.diaper is map && !isDiaperMapApproved(request.resource.data.diaper))
        )
      ) || (
        resource != null &&
        (!('creator_uid' in resource.data) || request.resource.data.get('creator_uid', null) == resource.data.creator_uid) &&
        (!('created_at' in resource.data) || request.resource.data.get('created_at', null) == resource.data.created_at) &&
        (
          request.resource.data.get('diaper', null) == resource.data.get('diaper', null) ||
          request.resource.data.get('diaper', null) == null ||
          (
            request.resource.data.get('diaper', null) is string &&
            (!isDiaperStringApproved(request.resource.data.diaper) || isExistingDiaperApproved())
          ) ||
          (
            request.resource.data.get('diaper', null) is map &&
            (!isDiaperMapApproved(request.resource.data.diaper) || isExistingDiaperApproved())
          )
        )
      );
    }

    function isValidPatientImage(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 30 &&
        isOptionalStringOrNumber(data, 'patient_id', 128, 0, 999999999999999) &&
        isOptionalString(data, 'type', 50) &&
        isOptionalString(data, 'category', 50) &&
        isOptionalString(data, 'profile_pic', 900000) &&
        isOptionalString(data, 'pic_bed', 900000) &&
        isOptionalString(data, 'pic_bath', 900000) &&
        isOptionalString(data, 'pic_entrance', 900000) &&
        isOptionalString(data, 'pic_walkway', 900000) &&
        isOptionalString(data, 'image', 900000) &&
        isOptionalString(data, 'image_data', 900000) &&
        isOptionalString(data, 'data_url', 900000) &&
        isOptionalString(data, 'url', 900000) &&
        isOptionalString(data, 'base64', 900000) &&
        isOptionalString(data, 'updated_by', 128) &&
        isOptionalString(data, 'uploader_uid', 128) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isValidAssessment(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 30 &&
        ('patient_id' in data) &&
        (
          (data.patient_id is string && data.patient_id.size() >= 1 && data.patient_id.size() <= 128) ||
          (data.patient_id is number && data.patient_id >= 0)
        ) &&
        isOptionalString(data, 'type', 50) &&
        isOptionalString(data, 'date', 50) &&
        isOptionalStringOrNumber(data, 'score1', 20, 0, 1000) &&
        isOptionalStringOrNumber(data, 'score2', 20, 0, 1000) &&
        isOptionalString(data, 'result', 300) &&
        (
          !('answers' in data) || data.answers == null ||
          (data.answers is map && data.answers.keys().size() <= 50) ||
          (data.answers is list && data.answers.size() <= 50) ||
          (data.answers is string && data.answers.size() <= 5000)
        ) &&
        isOptionalString(data, 'assessor_uid', 128) &&
        isOptionalString(data, 'assessor_name', 200) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isValidVital(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 30 &&
        ('patient_id' in data) &&
        (
          (data.patient_id is string && data.patient_id.size() >= 1 && data.patient_id.size() <= 128) ||
          (data.patient_id is number && data.patient_id >= 0)
        ) &&
        isOptionalString(data, 'date', 50) &&
        isOptionalStringOrNumber(data, 'sys', 20, 0, 2000) &&
        isOptionalStringOrNumber(data, 'dia', 20, 0, 2000) &&
        isOptionalStringOrNumber(data, 'hr', 20, 0, 2000) &&
        isOptionalStringOrNumber(data, 'sugar', 20, 0, 2000) &&
        isOptionalStringOrNumber(data, 'temp', 20, 0, 200) &&
        isOptionalStringOrNumber(data, 'spo2', 20, 0, 200) &&
        isOptionalStringOrNumber(data, 'weight', 20, 0, 1000) &&
        isOptionalStringOrNumber(data, 'height', 20, 0, 500) &&
        isOptionalString(data, 'meal', 100) &&
        isOptionalString(data, 'note', 1000) &&
        isOptionalString(data, 'assessor_uid', 128) &&
        isOptionalString(data, 'assessor_name', 200) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isValidHomeVisit(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 40 &&
        ('patient_id' in data) &&
        (
          (data.patient_id is string && data.patient_id.size() >= 1 && data.patient_id.size() <= 128) ||
          (data.patient_id is number && data.patient_id >= 0)
        ) &&
        isOptionalString(data, 'date', 50) &&
        isOptionalString(data, 'visit_date', 50) &&
        isOptionalString(data, 'note', 5000) &&
        isOptionalString(data, 'summary', 5000) &&
        isOptionalString(data, 'symptoms', 5000) &&
        isOptionalString(data, 'care_provided', 5000) &&
        isOptionalString(data, 'recommendations', 5000) &&
        isOptionalString(data, 'lat_long', 150) &&
        isOptionalString(data, 'gps', 150) &&
        isOptionalString(data, 'photo', 700000) &&
        isOptionalString(data, 'visit_pic', 700000) &&
        isOptionalString(data, 'image', 700000) &&
        isOptionalBoundedList(data, 'photos', 20) &&
        isOptionalBoundedList(data, 'images', 20) &&
        isOptionalBoundedList(data, 'tasks', 50) &&
        isOptionalString(data, 'visitor_uid', 128) &&
        isOptionalString(data, 'assessor_uid', 128) &&
        isOptionalString(data, 'vhv_uid', 128) &&
        isOptionalString(data, 'visitor_name', 200) &&
        isOptionalString(data, 'assessor_name', 200) &&
        isOptionalString(data, 'vhv_name', 200) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isValidInventoryItem(data) {
      return data is map &&
        data.keys().size() >= 2 &&
        data.keys().size() <= 25 &&
        ('name' in data) && (data.name is string) && data.name.size() >= 1 && data.name.size() <= 200 &&
        ('balance' in data) && (data.balance is number) && data.balance >= -1000000 && data.balance <= 100000000 &&
        isOptionalString(data, 'id', 128) &&
        isOptionalString(data, 'unit', 50) &&
        isOptionalString(data, 'category', 100) &&
        isOptionalStringOrNumber(data, 'min_stock', 20, 0, 100000000) &&
        isOptionalStringOrNumber(data, 'price', 20, 0, 100000000) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isValidInventoryTransaction(data) {
      return data is map &&
        data.keys().size() >= 2 &&
        data.keys().size() <= 25 &&
        ('type' in data) && (data.type is string) && data.type.size() >= 1 && data.type.size() <= 50 &&
        ('items' in data) && (data.items is list) && data.items.size() >= 1 && data.items.size() <= 200 &&
        isOptionalString(data, 'round', 100) &&
        isOptionalString(data, 'note', 2000) &&
        isOptionalString(data, 'actor_uid', 128) &&
        isOptionalString(data, 'actor_name', 200) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100);
    }

    function isValidEquipmentItem(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 35 &&
        ('name' in data) && (data.name is string) && data.name.size() >= 1 && data.name.size() <= 250 &&
        isOptionalString(data, 'id', 128) &&
        isOptionalString(data, 'code', 128) &&
        isOptionalString(data, 'asset_code', 128) &&
        isOptionalString(data, 'serial_no', 128) &&
        isOptionalString(data, 'category', 100) &&
        isOptionalString(data, 'type', 100) &&
        isOptionalString(data, 'status', 100) &&
        isOptionalString(data, 'condition', 100) &&
        isOptionalString(data, 'unit', 50) &&
        isOptionalString(data, 'hospital_name', 300) &&
        isOptionalString(data, 'location', 300) &&
        isOptionalString(data, 'donor', 300) &&
        isOptionalString(data, 'note', 2000) &&
        isOptionalString(data, 'description', 2000) &&
        isOptionalString(data, 'image', 700000) &&
        isOptionalString(data, 'photo', 700000) &&
        isOptionalString(data, 'pic_url', 700000) &&
        isOptionalStringOrNumber(data, 'qty', 20, 0, 1000000) &&
        isOptionalStringOrNumber(data, 'total_qty', 20, 0, 1000000) &&
        isOptionalStringOrNumber(data, 'available_qty', 20, 0, 1000000) &&
        isOptionalStringOrNumber(data, 'balance', 20, 0, 1000000) &&
        isOptionalString(data, 'current_loan_id', 128) &&
        isOptionalString(data, 'current_patient_id', 128) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    function isValidEquipmentLoan(data) {
      return data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 40 &&
        isOptionalString(data, 'id', 128) &&
        isOptionalString(data, 'item_id', 128) &&
        isOptionalString(data, 'equipment_id', 128) &&
        isOptionalString(data, 'item_name', 250) &&
        isOptionalString(data, 'equipment_name', 250) &&
        isOptionalStringOrNumber(data, 'patient_id', 128, 0, 999999999999999) &&
        isOptionalString(data, 'patient_name', 300) &&
        isOptionalString(data, 'borrower_name', 300) &&
        isOptionalString(data, 'returner_name', 300) &&
        isOptionalString(data, 'borrower_phone', 50) &&
        isOptionalString(data, 'phone', 50) &&
        isOptionalStringOrNumber(data, 'village_no', 30, 0, 9999) &&
        isOptionalString(data, 'status', 50) &&
        isOptionalTimestampOrString(data, 'loan_date', 50) &&
        isOptionalTimestampOrString(data, 'return_date', 50) &&
        isOptionalTimestampOrString(data, 'due_date', 50) &&
        isOptionalString(data, 'note', 2000) &&
        isOptionalString(data, 'return_note', 2000) &&
        isOptionalString(data, 'condition_on_return', 500) &&
        isOptionalStringOrNumber(data, 'qty', 20, 1, 10000) &&
        isOptionalString(data, 'signature', 700000) &&
        isOptionalString(data, 'photo', 700000) &&
        isOptionalString(data, 'evidence_pic', 700000) &&
        isOptionalString(data, 'actor_uid', 128) &&
        isOptionalString(data, 'staff_uid', 128) &&
        isOptionalString(data, 'approved_by_uid', 128) &&
        isOptionalString(data, 'actor_name', 200) &&
        isOptionalString(data, 'staff_name', 200) &&
        isOptionalString(data, 'approved_by_name', 200) &&
        isOptionalTimestampOrString(data, 'timestamp', 100) &&
        isOptionalTimestampOrString(data, 'created_at', 100) &&
        isOptionalTimestampOrString(data, 'updated_at', 100);
    }

    // ===============================================================
    // Collection Security Rules
    // ===============================================================

    // 0. Session Binding: Firebase Anonymous Auth UID -> LINE LIFF UID
    match /Auth_Sessions/{authUid} {
      allow get: if isOwner(authUid);
      allow list: if false;
      allow create: if isOwner(authUid) && isValidAuthSession(request.resource.data);
      allow update: if isOwner(authUid) &&
        isValidAuthSession(request.resource.data) &&
        (!('created_at' in resource.data) || !('created_at' in request.resource.data) || request.resource.data.created_at == resource.data.created_at);
      allow delete: if false;
    }

    // 1. User Accounts & Roles (VHVs, Sub-Admins, Central Admins)
    match /VHVs/{liffUid} {
      // Approved users can read individual profiles; Pending/unregistered users can check ONLY their own status.
      allow get: if isAuthenticated() && (isApprovedUser() || isSessionOwner(liffUid));
      allow list: if isApprovedUser();

      allow create: if isAuthenticated() &&
        !exists(/databases/$(database)/documents/VHVs/$(liffUid)) &&
        isSessionOwner(liffUid) &&
        isValidVhv(request.resource.data) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == liffUid) &&
        (
          // VHV self-registration (must start as Pending)
          (
            (request.resource.data.role in ['VHV', 'vhv', 'Vhv'] || request.resource.data.role.matches('(?i)^\\s*vhv\\s*$')) &&
            (request.resource.data.status in ['Pending', 'pending', 'PENDING'] || request.resource.data.status.matches('(?i)^\\s*pending\\s*$'))
          ) ||
          // Central Admin registration with secret code verification
          (
            (request.resource.data.role in ['ADMIN', 'admin', 'Admin'] || request.resource.data.role.matches('(?i)^\\s*admin\\s*$')) &&
            (request.resource.data.status in ['Active', 'active', 'ACTIVE'] || request.resource.data.status.matches('(?i)^\\s*active\\s*$')) &&
            isValidAdminSecretVerify(request.resource.data)
          ) ||
          // Sub-Admin registration with secret code verification
          (
            (request.resource.data.role in ['SUB_ADMIN', 'sub_admin', 'Sub_Admin'] || request.resource.data.role.matches('(?i)^\\s*sub_admin\\s*$')) &&
            (request.resource.data.status in ['Active', 'active', 'ACTIVE'] || request.resource.data.status.matches('(?i)^\\s*active\\s*$')) &&
            isValidSubAdminSecretVerify(request.resource.data)
          )
        );

      allow update: if isAuthenticated() &&
        isValidVhv(request.resource.data) &&
        uidNotModified() &&
        (
          // Central Admin: full user management
          isAdmin() ||
          // Sub-Admin: approve/reject/manage VHV accounts only (cannot modify or promote to ADMIN/SUB_ADMIN)
          (
            isSubAdmin() &&
            (
              !('role' in resource.data) || resource.data.role == null ||
              (
                resource.data.role is string &&
                (
                  resource.data.role in ['VHV', 'vhv', 'Vhv', 'None', 'none', 'NONE'] ||
                  resource.data.role.matches('(?i)^\\s*(vhv|none)\\s*$')
                )
              )
            ) &&
            (
              request.resource.data.role in ['VHV', 'vhv', 'Vhv', 'None', 'none', 'NONE'] ||
              request.resource.data.role.matches('(?i)^\\s*(vhv|none)\\s*$')
            ) &&
            (
              request.resource.data.status in ['Active', 'active', 'ACTIVE', 'Pending', 'pending', 'PENDING', 'Rejected', 'rejected', 'REJECTED'] ||
              request.resource.data.status.matches('(?i)^\\s*(active|pending|rejected)\\s*$')
            )
          ) ||
          // Self-profile edit (vhv_settings.html / admin_settings.html): strictly non-privilege profile fields
          (
            isApprovedUser() &&
            isSessionOwner(liffUid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'nickname', 'phone', 'profile_pic', 'pic_url', 'photoURL', 'hospital_name', 'updated_at', 'fcm_token'
            ]) &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.get('village_no', null) == resource.data.get('village_no', null) &&
            request.resource.data.get('assigned_villages', null) == resource.data.get('assigned_villages', null)
          )
        );

      allow delete: if isAdmin();
    }

    // 2. System Configuration
    match /SystemConfig/{configId} {
      allow get: if (
          configId in ['HOSPITAL_NAME', 'SYSTEM_NAME', 'VILLAGE_COUNT', 'SUB_CENTERS', 'ADMIN_SECRET_CODE'] &&
          isAuthenticated()
        ) || isApprovedUser();
      allow list: if isApprovedUser();
      allow create, update: if isAdmin() && isValidSystemConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    // 3. Central Admin Configs & Drafts (e.g., FinanceDraft, DiaperProjectSummary)
    match /Configs/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidConfigDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    // 4. Patient Registry & Care Profiles
    match /Patients/{patientId} {
      allow read: if isApprovedUser();
      allow create: if isStaff() || (isActiveVHV() && isValidPatient(request.resource.data) && canVhvWritePatient());
      allow update: if isStaff() || (isActiveVHV() && isValidPatient(request.resource.data) && canVhvWritePatient());
      allow delete: if isStaff();
    }

    // 5. Patient Home & Profile Images
    match /Patient_Images/{imageId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser() && isValidPatientImage(request.resource.data);
      allow delete: if isStaff() || isActiveVHV();
    }

    // 6. Clinical Assessments, Vitals & Home Visits
    match /Assessments/{assessId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser() && isValidAssessment(request.resource.data);
      allow delete: if isStaff() || isActiveVHV();
    }

    match /Vitals/{vitalId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser() && isValidVital(request.resource.data);
      allow delete: if isStaff() || isActiveVHV();
    }

    match /Home_Visits/{visitId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser() && isValidHomeVisit(request.resource.data);
      allow delete: if isStaff() || isActiveVHV();
    }

    // 7. Central Inventory & Stock Transactions
    match /Inventory_Items/{itemId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && isValidInventoryItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /Inventory_Transactions/{txId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && isValidInventoryTransaction(request.resource.data);
      allow delete: if isAdmin();
    }

    // 8. Medical Equipment Bank & Loans
    match /Equipment_Items/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidEquipmentItem(request.resource.data);
      allow delete: if isStaff();
    }

    match /Equipment_Loans/{loanId} {
      allow read: if isApprovedUser();
      allow create, update: if isStaff() && isValidEquipmentLoan(request.resource.data);
      allow delete: if isStaff();
    }

    // 9. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
